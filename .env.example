# ==============================================================================
# MEDSYNC SAAS - VARIÁVEIS DE AMBIENTE (VERCEL & DESENVOLVIMENTO)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.local para testes locais.
# 2. Na Vercel (Project Settings > Environment Variables), configure as chaves
#    marcando os ambientes correspondentes (Production, Preview, Development).
# 3. Nunca insira chaves privadas de serviço (service_role) no frontend Vite!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXÃO COM O SUPABASE (Obrigatório em Production, Preview e Development)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (encontrado em Project Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Chave pública anônima (anon public key). Seguro para exposição no client-side
# protegida por políticas Row Level Security (RLS) no PostgreSQL.
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÃO DE BASE PATH (Opcional - Gerenciado Automaticamente)
# ------------------------------------------------------------------------------
# Na Vercel e domínios próprios (app.* e www.*), o Vite assume '/' por padrão.
# No GitHub Actions para GitHub Pages, o workflow injeta '/clinica_medica/'.
# VITE_BASE_PATH="/"

# ------------------------------------------------------------------------------
# 3. AMBIENTE E INTEGRAÇÕES ADICIONAIS (Opcional)
# ------------------------------------------------------------------------------
# Modo de ambiente: 'production' | 'staging' | 'preview' | 'development'
VITE_APP_ENV="production"

# URL canônica da aplicação principal
# Vercel: VERCEL_URL é injetada nativamente pelo runtime Vercel
APP_URL="https://medsync.io"
